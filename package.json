{
  "name": "portfolio-app",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build && vite build --ssr src/entry-prerender.tsx --outDir dist-ssr && node scripts/prerender.mjs",
    "preview": "node scripts/preview.mjs",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "tsc --noEmit",
    "typecheck:config": "tsc --project tsconfig.node.json --noEmit",
    "test": "playwright test",
    "test:chromium": "playwright test --project=chromium",
    "images": "node scripts/optimize-images.mjs",
    "typecheck:qa": "tsc --project tsconfig.qa.json --noEmit"
  },
  "dependencies": {
    "lucide-react": "0.545.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "^7.13.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "@types/node": "^22.20.5",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.0.0",
    "autoprefixer": "^10.4.0",
    "eslint": "^10.14.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.4.26",
    "globals": "^16.5.0",
    "postcss": "^8.4.0",
    "sharp": "^0.35.5",
    "tailwindcss": "^3.3.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^4.0.0"
  },
  "engines": {
    "node": ">=22.13.0 <23 || >=24 <25"
  }
}
